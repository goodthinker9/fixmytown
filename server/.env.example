# ---- FixMyTown server environment ----
# Copy this file to ".env" and fill in your real values.

# Server port
PORT=4000

# Database connection string
# From Supabase: Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://pz@db.PROJECT_REF.supabase.co:5432/postgres

# JWT signing secret (use a long random string, at least 16 characters)
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# Frontend origin allowed by CORS (Vite default dev port)
CORS_ORIGIN=http://localhost:5173

# Environment
NODE_ENV=development

# ---- Supabase (for Storage image uploads) ----
# Project URL: Supabase dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Service role key: Supabase dashboard > Project Settings > API > service_role secret.
# SERVER-SIDE ONLY. Never put this in the frontend or expose it to browsers.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
